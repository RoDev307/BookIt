# Global ignores
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# Environment files (NEVER commit .env)
.env
.env.*
*.env
**/.env
**/.env.*

# Dependencies
node_modules/
vendor/
**/node_modules/
**/vendor/

# Backend specific
backend/.env
backend/.env.backup
backend/.env.production
backend/node_modules/
backend/vendor/
backend/public/hot
backend/storage/*.key
backend/storage/ca.pem
backend/storage/pail
backend/database/database.sqlite
backend/.phpunit.result.cache
backend/.phpunit.cache/

# Frontend specific
frontend/**/.env*
frontend/**/node_modules/
frontend/**/dist/
frontend/**/build/
frontend/**/www/
frontend/**/.angular/

